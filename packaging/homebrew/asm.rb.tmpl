class Asm < Formula
  desc "CLI for Agents Secrets Manager: operator-approved secrets for coding agents"
  homepage "https://github.com/Thinkscape/asm"
  license "Apache-2.0"

  if OS.mac?
    url "https://github.com/Thinkscape/asm/releases/download/v@VERSION@/asm-macos-universal.tar.gz"
    sha256 "@SHA256_MACOS_UNIVERSAL@"
  elsif Hardware::CPU.arm?
    url "https://github.com/Thinkscape/asm/releases/download/v@VERSION@/asm-linux-aarch64.tar.gz"
    sha256 "@SHA256_LINUX_AARCH64@"
  else
    url "https://github.com/Thinkscape/asm/releases/download/v@VERSION@/asm-linux-x86_64.tar.gz"
    sha256 "@SHA256_LINUX_X86_64@"
  end

  def install
    bin.install "asm"
    pkgshare.install "skill"
  end

  def caveats
    <<~EOS
      Pair this machine with the manager on the operator's Mac:
        asm pair <manager-host>
      The agent skill is at:
        #{opt_pkgshare}/skill/asm/SKILL.md
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/asm --version")
    output = shell_output("#{bin}/asm doctor 2>&1", 1)
    assert_match "FAIL paired", output
  end
end
